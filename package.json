{
  "name": "dbml-designer",
  "private": true,
  "version": "0.1.0",
  "description": "A DBML REPL viewer: type DBML on the right, see the entity-relationship diagram on the left.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.cli.json",
    "check": "tsx --tsconfig tsconfig.app.json cli/dbml-designer.ts check",
    "graph": "tsx --tsconfig tsconfig.app.json cli/dbml-designer.ts graph"
  },
  "dependencies": {
    "@dbml/parse": "^10.1.1",
    "@fontsource/inconsolata": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@phosphor-icons/vue": "^2.2.1",
    "@vue/devtools-api": "^8.2.1",
    "dompurify": "^3.4.15",
    "lodash-es": "^4.18.1",
    "marked": "^18.0.13",
    "monaco-editor": "^0.56.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.15"
    }
  }
}
