{
  "name": "dbml-designer",
  "private": true,
  "version": "0.1.0",
  "description": "A diagram engine for database DAGs and the DBML editor built on it.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/engine",
    "packages/editor"
  ],
  "scripts": {
    "dev": "npm run dev -w @dbml-designer/editor",
    "build": "npm run build -w @dbml-designer/engine && npm run build -w @dbml-designer/editor",
    "preview": "npm run preview -w @dbml-designer/editor",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "npm run type-check --workspaces",
    "check": "tsx --tsconfig packages/editor/tsconfig.app.json packages/editor/cli/dbml-designer.ts check",
    "graph": "tsx --tsconfig packages/editor/tsconfig.app.json packages/editor/cli/dbml-designer.ts graph"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.15"
    }
  }
}
