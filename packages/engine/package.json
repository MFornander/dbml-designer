{
  "name": "@dbml-designer/engine",
  "version": "0.1.0",
  "description": "A diagram engine for database schemas and their lineage: draws tables, relationships, lineage edges, groups, notes, and views from a plain JSON model, with the layout kept per instance.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "scripts": {
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.5.42"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "dompurify": "^3.4.15",
    "marked": "^18.0.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "typescript": "~6.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
