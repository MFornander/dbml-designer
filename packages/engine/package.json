{
  "name": "@dbml-designer/engine",
  "version": "0.6.0",
  "description": "Interactive diagrams of database schemas and data lineage, drawn from a plain JSON model: tables, relationships, lineage edges, groups, notes, views, and rows of data. Built for Vue 3 hosts, with a standalone build for any page.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "api.json",
    "model.schema.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/core.js"
    },
    "./standalone": {
      "types": "./dist/types/standalone.d.ts",
      "import": "./dist/standalone/standalone.js"
    },
    "./model.schema.json": "./model.schema.json",
    "./api.json": "./api.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.standalone.config.ts && vue-tsc -p tsconfig.build.json",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "api": "ENGINE_API_UPDATE=1 vitest run src/__tests__/api.test.ts"
  },
  "peerDependencies": {
    "vue": "^3.5.42"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "dompurify": "^3.4.15",
    "marked": "^18.0.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "ajv": "^8.20.0",
    "happy-dom": "^20.14.5",
    "typescript": "~6.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
