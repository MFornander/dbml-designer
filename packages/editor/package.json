{
  "name": "@dbml-designer/editor",
  "private": true,
  "version": "0.1.0",
  "description": "DBML Designer, the app: a Monaco DBML editor beside a live diagram you arrange, with the layout kept in the .dbml file, files on disk followed through the dev server, an iframe embedding API, and check and graph commands for scripts and agents.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.cli.json && vue-tsc --noEmit -p tsconfig.node.json",
    "check": "tsx --tsconfig tsconfig.app.json cli/dbml-designer.ts check",
    "graph": "tsx --tsconfig tsconfig.app.json cli/dbml-designer.ts graph"
  },
  "dependencies": {
    "@dbml-designer/engine": "0.4.2",
    "@dbml/parse": "^10.2.0",
    "@fontsource/inconsolata": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@phosphor-icons/vue": "^2.2.1",
    "@vue/devtools-api": "^8.2.1",
    "dompurify": "^3.4.15",
    "jsonc-parser": "^3.3.1",
    "lodash-es": "^4.18.1",
    "marked": "^18.0.13",
    "monaco-editor": "^0.56.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
